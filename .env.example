# nanobanana-mcp configuration
#
# This file documents every environment variable the server reads. Copy the
# block for the auth mode you're using into your MCP client's config (or a
# real .env if you run the server standalone) — you only need ONE of the
# three auth modes below.
#
# This file is for reference; nanobanana-mcp does not read .env files itself
# (most MCP clients inject "env" values directly into the server process).

# ---------------------------------------------------------------------------
# Mode 1: Gemini Developer API (AI Studio) — simplest option
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Mode 2: Vertex AI / Gemini Enterprise Agent Platform — Express Mode
# An API key that works against Vertex without a full GCP project.
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
# VERTEX_API_KEY=

# ---------------------------------------------------------------------------
# Mode 3: Vertex AI / Gemini Enterprise Agent Platform — ADC
# Requires a GCP project, and Application Default Credentials available via
# ONE of: `gcloud auth application-default login`, GOOGLE_APPLICATION_CREDENTIALS
# pointing at a service account JSON key, or an attached service account when
# running on GCP compute.
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---------------------------------------------------------------------------
# Optional: force a specific auth mode instead of auto-detecting from the
# variables above. Values: gemini | vertex-express | vertex-adc
# ---------------------------------------------------------------------------
# NANOBANANA_AUTH_MODE=

# ---------------------------------------------------------------------------
# Optional: general behavior
# ---------------------------------------------------------------------------
# Default model when a tool call omits `model` or passes "auto" is still
# smart-selected between Nano Banana 2 / Pro; this only overrides the
# fallback model id used internally (rarely needed).
# NANOBANANA_DEFAULT_MODEL=gemini-3.1-flash-image

# Directory generated images are saved to. If unset, images are only
# returned inline (base64) unless a tool call passes save_to_file: true.
# NANOBANANA_OUTPUT_DIR=/absolute/path/to/output/dir

# debug | info | warn | error (default: info). Always written to stderr.
# NANOBANANA_LOG_LEVEL=info

# In-memory response cache for identical repeated requests.
# NANOBANANA_CACHE_ENABLED=true
# NANOBANANA_CACHE_TTL_MS=600000
# NANOBANANA_CACHE_MAX_ENTRIES=20
